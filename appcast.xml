      <title>Version 1.1.2</title>
      <sparkle:version>8</sparkle:version>
      <sparkle:shortVersionString>1.1.2</sparkle:shortVersionString>
      <pubDate>Fri, 21 Aug 2026 10:00:00 +0000</pubDate>
      <description><![CDATA[
        <h2>Quirky v1.1.2</h2>
